# LLM Provider Configuration
# Options: local_qwen, nvidia_nim
# Global fallback if task-specific providers not set
LLM_PROVIDER=local_qwen

# Task-specific providers (overrides LLM_PROVIDER)
# SEMANTIC_LLM_PROVIDER: provider for semantic evaluation
# QUESTION_LLM_PROVIDER: provider for question generation
SEMANTIC_LLM_PROVIDER=local_qwen
QUESTION_LLM_PROVIDER=local_qwen

# Local LLM Configuration
LOCAL_QWEN_MODEL=Qwen/Qwen1.5-4B-Chat
LOCAL_QWEN_DEVICE=auto
LOCAL_QWEN_QUANTIZATION=int4

# Task-specific local models (overrides LOCAL_QWEN_MODEL for each task)
# Semantic evaluation: Qwen2.5-7B-Instruct for better reasoning
SEMANTIC_MODEL=Qwen/Qwen2.5-7B-Instruct
SEMANTIC_QUANTIZATION=int4

# Question generation: Qwen 4B for faster generation
QUESTION_MODEL=Qwen/Qwen1.5-4B-Chat
QUESTION_QUANTIZATION=int4

# NVIDIA NIM Configuration - Semantic Evaluation (Reasoning)
NVIDIA_REASONING_API_KEY=your_nvidia_reasoning_api_key_here
NVIDIA_REASONING_MODEL=openai/gpt-oss-20b

# NVIDIA NIM Configuration - Question Generation (not used in hybrid config)
NVIDIA_QUESTION_API_KEY=your_nvidia_question_api_key_here
NVIDIA_QUESTION_MODEL=openai/gpt-oss-20b
